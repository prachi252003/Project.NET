@model TrainingPortal.Entities.Models.Training

<h2>Edit Training</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.TrainingId)

    <div class="form-group">
        @Html.LabelFor(m => m.TrainerId)
        @Html.EditorFor(m => m.TrainerId)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.TechnologyId)
        @Html.EditorFor(m => m.TechnologyId)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.StartDate)
        @Html.EditorFor(m => m.StartDate)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.EndDate)
        @Html.EditorFor(m => m.EndDate)
    </div>

    <input type="submit"
           value="Save"
           class="btn btn-success" />
}