@model TrainingPortal.Entities.Models.Trainer

@{
    ViewBag.Title = "Delete Trainer";
}

<h2>Delete Trainer</h2>

<h3>Are you sure you want to delete this trainer?</h3>

<div>

    <dl class="dl-horizontal">

        <dt>Trainer Id</dt>
        <dd>@Model.TrainerId</dd>

        <dt>Name</dt>
        <dd>@Model.Name</dd>

        <dt>Type</dt>
        <dd>@Model.Type</dd>

        <dt>Email</dt>
        <dd>@Model.Email</dd>

        <dt>Phone</dt>
        <dd>@Model.Phone</dd>

    </dl>

    @using (Html.BeginForm())
    {
        <input type="submit"
               value="Delete"
               class="btn btn-danger" />
    }

    <br />

    @Html.ActionLink("Back To List", "Index")

</div>