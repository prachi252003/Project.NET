@model TrainingPortal.Entities.Models.Technology

@{
    ViewBag.Title = "Delete";
}

<h2>Delete Technology</h2>

<h3>Are you sure you want to delete this?</h3>

<dl class="dl-horizontal">

    <dt>Technology Id</dt>
    <dd>@Model.TechnologyId</dd>

    <dt>Name</dt>
    <dd>@Model.Name</dd>

    <dt>Level</dt>
    <dd>@Model.Level</dd>

    <dt>Duration</dt>
    <dd>@Model.Duration</dd>

</dl>

@using (Html.BeginForm())
{
    <input type="submit"
           value="Delete"
           class="btn btn-danger" />
}

@Html.ActionLink("Back To List", "Index")